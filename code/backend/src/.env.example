# 复制到 code/backend/src/.env 后修改（.env 不提交）。
# 运行目录是 code/backend/src，所有相对路径都相对它。

# JWT 签名密钥，生产环境务必改成随机长串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
SECRET_KEY=change-me-to-a-random-long-string

# 运行时目录：日志与附属数据的根。不填则按代码位置推算为
# code/backend/log 与 code/backend/data；生产可改成独立挂载盘的绝对路径。
# LOG_DIR=/data/majiang/log
# DATA_DIR=/data/majiang/data

# 数据库连接串。不填则默认 SQLite，文件落在 data/db/mahjong.db（绝对路径），
# 不会在代码目录里散落 .db。切 MySQL/PostgreSQL 时在此覆盖。
# DATABASE_URL=mysql+pymysql://mjapp:<口令>@127.0.0.1:3306/mahjong_data?charset=utf8mb4

# 首个管理员的用户名与初始密码。密码留空则启动时随机生成并打印到日志（只打印一次）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# 登录态有效期（小时），默认 30 天，家人不用反复登录
TOKEN_TTL_HOURS=720

# 允许跨域的来源，本地开发用 *，线上建议写自己的域名
CORS_ORIGINS=*

# 生产环境建议开为 true，登录态 Cookie 只走 HTTPS（当前前端用 localStorage 存 token，此项仅备用）
SECURE_COOKIES=false
