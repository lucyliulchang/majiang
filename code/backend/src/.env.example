# 工作目录 = code/backend/src（所有相对路径、启动命令与 pytest 都相对它）。
# 复制到 code/backend/src/.env 后修改（.env 不提交）。

# 环境名：local（本机开发）/ test_server（测试服）/ server_01（生产）。
# 只影响 config/localSettings.py 的环境映射；其余差异一律由本文件给出。
APP_ENV=local

# JWT 签名密钥，生产环境务必改成随机长串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
SECRET_KEY=change-me-to-a-random-long-string

# 运行时目录：日志与附属数据的根。不填则按代码位置推算为
# code/backend/log 与 code/backend/data；生产可改成独立挂载盘的绝对路径。
# LOG_DIR=/data/majiang/log
# DATA_DIR=/data/majiang/data

# 数据库：S5 起全部走 MySQL（ORM/SQLite 已移除），连接参数见下方 MYSQL_*。
# DATABASE_URL 仅为兼容旧配置保留，业务代码不再读取。

# ---- MySQL（唯一数据源）----
# 环境映射：local/test_server → 默认库 mahjong_data/mahjong_test，server_01 → mahjong_data。
# 口令只放本文件或环境变量，禁止写进代码、文档与日志；本文件不提交（.gitignore 已忽略）。
MYSQL_WRITE_HOST=127.0.0.1
MYSQL_WRITE_PORT=3306
MYSQL_WRITE_DB=mahjong_data
MYSQL_WRITE_USER=mjapp
MYSQL_WRITE_PASSWD=
MYSQL_READ_HOST=127.0.0.1
MYSQL_READ_PORT=3306
MYSQL_READ_DB=mahjong_data
MYSQL_READ_USER=mjapp
MYSQL_READ_PASSWD=
# 连接池上限，取值 5–20，默认 10
MYSQL_POOL_MAX=10
# 1 = 导入 config/mysqlSettings.py 时不建连（无库环境/CI 用）
MYSQL_SKIP_CONNECT=

# ---- 账号服务（contentHub acis）----
# 登录/注册/改密/找回口令全部转发账号服务，本地不校验口令、不自建账号表。
# 与麻将不同机时改成实际地址；末尾 /acis 不可省略。
ACCOUNT_SERVICE_URL=http://127.0.0.1:8160/acis
# 自助注册开关：生产默认 false（入口由 /api/auth/options 下发，前端不写死）。
# 置 true 时账号服务仍会校验短信验证码（A6A0 >>> A0A0 + verifyCode）。
ACCOUNT_ALLOW_REGISTER=false
# 自助找回口令开关：默认 true（家庭场景需要），false 时前端隐藏「忘记密码」。
ACCOUNT_ALLOW_PASSWORD_RESET=true
# 未返回/不在 acis 管理员白名单（administrator/manager）时的本系统角色：admin | member
ACCOUNT_DEFAULT_ROLE=member
# 验证码本地限流（进程内计数，不落库、不缓存明文）：
# 同一 login_id 60 秒内只能发一次；连续 5 次校验失败后必须重新获取
AUTH_VERIFY_CODE_COOLDOWN_SECONDS=60
AUTH_VERIFY_CODE_MAX_ATTEMPTS=5

# ---- 观战（S5b / 00 §4.3 G13）----
# 一人一目标：每名在座玩家最多被 10 名观战者跟随，全房 4×10=40 个名额；
# 观战连接全断后绑定保留 60 秒（期间重连恢复原目标且不重复占位）。非法值回退默认。
SPECTATE_LIMIT_PER_SEAT=10
SPECTATE_ROOM_MAX=40
SPECTATE_RESERVE_SECONDS=60

# 登录态有效期（小时），默认 30 天，家人不用反复登录
TOKEN_TTL_HOURS=720

# 允许跨域的来源，本地开发用 *，线上建议写自己的域名
CORS_ORIGINS=*

# 生产环境建议开为 true，登录态 Cookie 只走 HTTPS（当前前端用 localStorage 存 token，此项仅备用）
SECURE_COOKIES=false
