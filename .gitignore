# Python
__pycache__/
*.py[cod]
.pytest_cache/
code/backend/src/.venv/
code/backend/src/.env

# 日志：全部落在 code/backend/log/（骨架用 .gitkeep 保留）
code/backend/log/*.log
code/backend/log/*.log.*
code/backend/log/schedule/*.log
code/backend/log/schedule/backup/

# 附属数据：全部落在 code/backend/data/
# 数据库（含 WAL 边车文件）—— 备份走 sqlite3 .backup
code/backend/data/db/*.db*
code/backend/data/test/*.db*
# 定时备份产物（本机保留，不入库）
code/backend/data/backup/*
!code/backend/data/backup/.gitkeep
# 前端可直接访问的图片（皮肤等运行时上传物）
code/backend/data/webserver/majiangapp/tiles/*
!code/backend/data/webserver/majiangapp/tiles/.gitkeep

# 前端
code/frontend/node_modules/
code/frontend/dist/

# 工具与联调产物
.playwright-cli/
shots/
code/deploy/mj_dist.tar.gz
code/deploy/*_result.txt
code/deploy/s10_skin_panel_debug.png

# 一次性联调/运维脚本：含测试环境地址与口令，本机保留、不入库
code/deploy/remote-*.sh
!code/deploy/remote-deploy-front.sh
code/deploy/remote-*.py
code/deploy/s10_*.py
