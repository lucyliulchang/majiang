# 复制为 .env 后修改。.env 不要提交到版本库。
# JWT 签名密钥，生产环境务必改成随机长串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
SECRET_KEY=change-me-to-a-random-long-string

# 数据库连接串。默认 SQLite 单文件，留好升级 PostgreSQL 的口子
DATABASE_URL=sqlite:///./mahjong.db

# 首个管理员的用户名与初始密码。密码留空则启动时随机生成并打印到日志（只打印一次）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=

# 登录态有效期（小时），默认 30 天，家人不用反复登录
TOKEN_TTL_HOURS=720

# 允许跨域的来源，本地开发用 *，线上建议写自己的域名
CORS_ORIGINS=*

# 生产环境建议开为 true，登录态 Cookie 只走 HTTPS（当前前端用 localStorage 存 token，此项仅备用）
SECURE_COOKIES=false
